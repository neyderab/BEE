# Copia este archivo como .env y completa los valores.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# "require" para bases en la nube; "disable" para PostgreSQL local.
DB_SSLMODE=require
# Clave para firmar la cookie de sesión. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# En producción (HTTPS) pon 1 para que la cookie de sesión solo viaje cifrada.
COOKIE_SEGURA=0
# Notificaciones push (crea las claves con: python scripts/generar_claves_push.py).
# En desarrollo se pueden dejar vacías: se crean solas en .claves_push.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# SMS con Twilio (opcional). Sin estas tres, el código de prueba es 123456.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO=
# 1 = cuenta de prueba de Twilio: envía la plantilla 2FA (código fijo 482913). Solo para demostrar.
TWILIO_CUENTA_DE_PRUEBA=
