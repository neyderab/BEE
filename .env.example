# Copia este archivo como .env y completa los valores.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# "require" para bases en la nube; "disable" para PostgreSQL local.
DB_SSLMODE=require
# Clave para firmar la cookie de sesión. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
